<section class="intro-card"><p class="eyebrow">WELCOME TO MY NOTEBOOK</p><h2>把想法写下来，<br /><span>让时间留下痕迹。</span></h2><p>这里记录编程学习、阅读心得和生活随想。每一篇文章都用 Markdown 写成，再由 Hexo 自动生成网页。</p></section>
<section class="posts" aria-label="文章列表">
  <% page.posts.each(function(post){ %>
    <article class="post-card" data-search="<%= post.title %> <%= strip_html(post.excerpt || post.content).slice(0, 300) %>">
      <h2><a href="<%= url_for(post.path) %>"><%= post.title %></a></h2>
      <div class="post-meta"><span><i class="fa-regular fa-calendar"></i>发表于 <%= date(post.date, 'YYYY-MM-DD') %></span><span><i class="fa-regular fa-clock"></i>阅读 <%= Math.max(1, Math.ceil(strip_html(post.content).length / 350)) %> 分钟</span></div>
      <div class="post-excerpt"><%- post.excerpt || truncate(strip_html(post.content), {length: 180}) %></div>
      <div class="post-tags"><% post.tags.each(function(tag){ %><a href="<%= url_for(tag.path) %>"><%= tag.name %></a><% }) %></div>
      <a class="read-more" href="<%= url_for(post.path) %>">阅读全文 <span>→</span></a>
    </article>
  <% }) %>
</section>
