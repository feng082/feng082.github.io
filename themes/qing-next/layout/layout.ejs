<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="<%= config.description %>" />
    <title><%= page.title ? page.title + ' | ' : '' %><%= config.title %></title>
    <link rel="stylesheet" href="<%= url_for('/css/style.css') %>" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
  </head>
  <body>
    <div class="headband"></div>
    <header class="site-header">
      <div class="brand-row">
        <button class="menu-toggle" type="button" aria-label="打开导航栏" aria-expanded="false"><span></span><span></span><span></span></button>
        <a class="brand" href="<%= url_for('/') %>"><i></i><h1><%= config.title %></h1><i></i></a>
        <button class="search-open icon-button" type="button" aria-label="搜索"><span class="fa-solid fa-magnifying-glass"></span></button>
      </div>
      <p class="subtitle"><%= config.subtitle %></p>
      <nav class="site-nav" aria-label="主导航">
        <% Object.keys(theme.menu).forEach(function(name){ %>
          <a href="<%= url_for(theme.menu[name]) %>"><span class="fa-solid <%= name === '首页' ? 'fa-house' : name === '标签' ? 'fa-tags' : name === '归档' ? 'fa-box-archive' : 'fa-user' %>"></span><%= name %></a>
        <% }) %>
        <button class="nav-search search-open" type="button"><span class="fa-solid fa-magnifying-glass"></span>搜索</button>
      </nav>
    </header>
    <div class="page-shell">
      <aside class="sidebar">
        <div class="sidebar-inner">
          <div class="avatar" aria-hidden="true">F</div>
          <h2><%= config.author %></h2>
          <p><%= config.description %></p>
          <div class="stats">
            <a href="<%= url_for('/archives/') %>"><strong><%= site.posts.length %></strong><span>日志</span></a>
            <a href="<%= url_for('/tags/') %>"><strong><%= site.tags.length %></strong><span>标签</span></a>
            <a href="<%= url_for('/about/') %>"><strong>1</strong><span>关于</span></a>
          </div>
          <div class="socials"><a href="https://github.com/feng082" target="_blank" rel="noreferrer" aria-label="GitHub"><span class="fa-brands fa-github"></span></a><a href="mailto:you@example.com" aria-label="邮箱"><span class="fa-solid fa-envelope"></span></a></div>
          <p class="license">本站内容采用<br /><a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh" target="_blank" rel="noreferrer">CC BY-NC-SA 4.0</a> 许可。</p>
        </div>
      </aside>
      <main class="main-content"><%- body %></main>
    </div>
    <div class="search-overlay" hidden><div class="search-dialog" role="dialog" aria-modal="true" aria-label="搜索文章"><div class="search-head"><span class="fa-solid fa-magnifying-glass"></span><input id="search-input" type="search" placeholder="搜索文章标题或内容…" autocomplete="off" /><button class="search-close" type="button" aria-label="关闭搜索">×</button></div><div id="search-results" class="search-results"><p>输入关键词开始搜索</p></div></div></div>
    <button class="back-top" type="button" aria-label="回到顶部">↑</button>
    <script src="<%= url_for('/js/site.js') %>"></script>
  </body>
</html>
