<article class="post-detail"><header><p class="eyebrow">BLOG POST</p><h1><%= page.title %></h1><div class="post-meta"><span><i class="fa-regular fa-calendar"></i>发表于 <%= date(page.date, 'YYYY-MM-DD') %></span><span><i class="fa-regular fa-clock"></i>阅读 <%= Math.max(1, Math.ceil(strip_html(page.content).length / 350)) %> 分钟</span></div></header><div class="post-body"><%- page.content %></div></article>
